{
  "version": "0.4.2",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "QavatarsRevived",
    "id": "qavatarsrevived",
    "version": "0.1.0",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/QavatarsRevived",
    "additionalData": {
      "overrideSoName": "libqavatarsrevived.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "cmake --build ./build"
      ],
      "configure": [
        "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=\"$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake\" -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-24 -DCMAKE_MAKE_PROGRAM=ninja -Bbuild -S."
      ],
      "clean": [
        "rm -rf ./build"
      ],
      "qmod": [
        "qpm qmod build"
      ]
    },
    "ndk": "^27.2.12479018",
    "qmodIncludeDirs": [],
    "qmodIncludeFiles": [],
    "qmodOutput": null
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4008.*",
      "additionalData": {
        "headersOnly": true,
        "compileOptions": {
          "includePaths": [
            "include"
          ],
          "cppFeatures": [],
          "cppFlags": [
            "-DNEED_UNSAFE_CSHARP",
            "-fdeclspec",
            "-DUNITY_2021",
            "-DHAS_CODEGEN",
            "-Wno-invalid-offsetof"
          ]
        }
      }
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.6.4",
      "additionalData": {}
    },
    {
      "id": "assimp",
      "versionRange": "*",
      "additionalData": {}
    },
    {
      "id": "sombrero",
      "versionRange": "*",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.55",
      "additionalData": {}
    },
    {
      "id": "fmt",
      "versionRange": "^11.0.0",
      "additionalData": {}
    },
    {
      "id": "kaleb",
      "versionRange": "^0.1.9",
      "additionalData": {}
    }
  ],
  "restoreConfig": null
}
