{
  "version": "0.4.2",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "QavatarsRevived",
    "id": "qavatarsrevived",
    "version": "0.1.0",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/QavatarsRevived",
    "additionalData": {
      "overrideSoName": "libqavatarsrevived.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "cmake --build ./build"
      ],
      "configure": [
        "cmake -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FILE=\"$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake\" -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-24 -DCMAKE_MAKE_PROGRAM=ninja -Bbuild -S."
      ],
      "clean": [
        "rm -rf ./build"
      ],
      "qmod": [
        "qpm qmod build"
      ]
    },
    "qmodIncludeDirs": [],
    "qmodIncludeFiles": [],
    "qmodOutput": null
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.0",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^3600.0.0",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "custom-types",
      "versionRange": "^0.17.0",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.4.0",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.5",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "song-control",
      "versionRange": "^0.1.0",
      "additionalData": {}
    }
  ],
  "restoreConfig": null
}
